        {"fieldname": "column_break_1", "fieldtype": "Column Break"},
        {"fieldname": "target_audience", "fieldtype": "Small Text", "label": "Target Audience"},
        {"fieldname": "section_break_1", "fieldtype": "Section Break", "label": "SWOT"},
        {"fieldname": "key_strength", "fieldtype": "Small Text", "label": "Key Strength"},
        {"fieldname": "key_weakness", "fieldtype": "Small Text", "label": "Key Weakness"},
        {"fieldname": "differentiation", "fieldtype": "Small Text", "label": "Differentiation"}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
    ]
}