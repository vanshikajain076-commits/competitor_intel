{
    "doctype": "DocType",
    "name": "Competitor Qualitative",
    "module": "Competitor Intel",
    "custom": 0,
    "istable": 0,
    "editable_grid": 1,
    "engine": "InnoDB",
    "autoname": "hash",
    "sort_field": "review_date",
    "sort_order": "DESC",
    "field_order": [
        "competitor",
        "review_date",
        "market_position",
        "pricing_model",
        "column_break_1",
        "target_audience",
        "section_break_1",
        "key_strength",
        "key_weakness",
        "differentiation"
