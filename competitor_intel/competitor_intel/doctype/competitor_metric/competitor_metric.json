{
    "doctype": "DocType",
    "name": "Competitor Metric",
    "module": "Competitor Intel",
    "custom": 0,
    "istable": 0,
    "editable_grid": 1,
    "engine": "InnoDB",
    "autoname": "hash",
    "sort_field": "metric_date",
    "sort_order": "DESC",
    "field_order": [
        "competitor",
        "metric_date",
        "metric_type",
        "value",
        "source"
    ],
    "fields": [
        {
            "fieldname": "competitor",
            "fieldtype": "Link",
            "label": "Competitor",
            "options": "Competitor",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "metric_date",
            "fieldtype": "Date",
            "label": "Date",
            "reqd": 1,
            "in_list_view": 1,
            "default": "Today"
        },
        {
            "fieldname": "metric_type",
            "fieldtype": "Select",
            "label": "Metric Type",
            "options": "Monthly Visits\nPage Views\nBounce Rate\nAvg Duration (seconds)\nPages per Visit\nSearch Trend Index\nReview Rating\nReview Count\nCloudflare Traffic Rank\nTraffic: Direct\nTraffic: Organic Search\nTraffic: Paid Search\nTraffic: Social\nTraffic: Referral\nTraffic: Email\nTraffic: Display Ads",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "value",
            "fieldtype": "Float",
            "label": "Value",
            "in_list_view": 1
        },
        {
            "fieldname": "source",
            "fieldtype": "Select",
            "label": "Source",
            "options": "Manual Entry\nMock API\nGoogle Trends\nCloudflare Radar (Exact Rank)\nCloudflare Radar (Bucket Estimate)\nOther",
            "default": "Manual Entry"
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        }
    ]
}